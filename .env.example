# ==========================================================
# ГлавПрофи — пример переменных окружения
# ==========================================================
# Скопируйте файл в .env и заполните реальными значениями.
# Реальные секреты в репозиторий не коммитим (.env в .gitignore).
# Nuxt автоматически подставляет переменные NUXT_<KEY> в runtimeConfig
# (см. nuxt.config.ts → runtimeConfig).

# --- App ---
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# --- База данных (MySQL) ---
NUXT_DB_HOST=localhost
NUXT_DB_PORT=3306
NUXT_DB_USER=root
NUXT_DB_PASSWORD=
NUXT_DB_NAME=glavprofi

# --- JWT ---
NUXT_JWT_SECRET=
JWT_SECRET=

# --- Socket.IO (realtime) ---
# Порт отдельного сокет-сервера в dev-режиме (server/socket/dev.ts).
# Клиент берёт это же значение из runtimeConfig.public.socketPort
# (services/socket.service.ts → resolveSocketUrl), поэтому менять нужно только здесь.
SOCKET_PORT=3001
# Явный адрес сокет-сервера, если он не на том же origin, что приложение.
# Пусто → prod: window.location (nginx проксирует /socket.io/), dev: http://<hostname>:<SOCKET_PORT>
NUXT_PUBLIC_SOCKET_URL=

# --- Uploads (dev-прокси изображений) ---
NUXT_DEV_UPLOADS_ORIGIN=https://glavprofi.ru

# --- Telegram Bot (опционально) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Email (опционально) ---
NUXT_EMAIL_HOST=
NUXT_EMAIL_PORT=465
NUXT_EMAIL_SECURE=true
NUXT_EMAIL_USER=
NUXT_EMAIL_PASS=
NUXT_EMAIL_TO=
NUXT_EMAIL_FROM=noreply@glavprofi.ru

# --- Аналитика посетителей ---
# Свои IP (офис/сотрудники), которые исключаются из трекинга посетителей.
# Несколько адресов через запятую: VISITOR_EXCLUDE_IPS=1.2.3.4, 5.6.7.8
VISITOR_EXCLUDE_IPS=
# Соль для хэширования IP перед сохранением (в БД попадает только хэш SHA-256).
VISITOR_IP_SALT=
# ID счётчика Яндекс.Метрики. Используется плагином app/plugins/yandexMetrica.js
# и для сверки clientID в трекинге посетителей (поле ym_client_id).
# Пример: YANDEX_METRICA_ID=93400187
YANDEX_METRICA_ID=
