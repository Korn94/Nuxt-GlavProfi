{
  "name": "nuxt-app",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev --host=0.0.0.0",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "start": "node .output/server/index.mjs",
    "postinstall": "nuxt prepare",
    "migrate": "npx drizzle-kit --config=drizzle.config.ts migrate",
    "migrate:generate": "npx drizzle-kit --config=drizzle.config.ts generate",
    "migrate:push": "npx drizzle-kit --config=drizzle.config.ts push",
    "migrate:all": "npm run migrate:generate && npm run migrate",
    "seed": "tsx server/db/seed.ts",
    "seed:pages": "tsx server/db/seed.ts --pages",
    "seed:roles": "tsx server/db/seed.ts --roles",
    "seed:force": "FORCE_SEED=true tsx server/db/seed.ts",
    "db:setup": "npm run migrate && npm run seed",
    "db:reset-roles": "npm run seed:roles"
  },
  "dependencies": {
    "@nuxtjs/sitemap": "^8.5.0",
    "@pinia/nuxt": "^1.0.2",
    "@telegram-apps/sdk": "^3.11.8",
    "animate.css": "^4.1.1",
    "bcryptjs": "^3.0.3",
    "buffer": "^6.0.3",
    "devtools": "^8.42.0",
    "echarts": "^6.1.0",
    "jsonwebtoken": "^9.0.3",
    "lru-cache": "^11.5.2",
    "node-cron": "^4.6.0",
    "node-telegram-bot-api": "^2.1.0",
    "nodemailer": "^9.1.1",
    "nuxt": "^4.5.2",
    "pinia": "^4.0.3",
    "sharp": "^0.35.4",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "vue-draggable-plus": "^0.6.1",
    "vue-the-mask": "^0.11.1",
    "vue3-dnd": "^2.1.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@iconify-json/material-symbols": "^1.2.90",
    "@iconify-json/material-symbols-light": "^1.2.90",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/solar": "^1.2.10",
    "@iconify-json/stash": "^1.2.4",
    "@iconify-json/weui": "^1.2.4",
    "@nuxt/icon": "^2.5.1",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node-telegram-bot-api": "^0.64.15",
    "@types/nodemailer": "^8.0.1",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "mysql2": "^3.24.3",
    "sass": "^1.103.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "type": "module"
}
